# ตั้งเป็น true เพื่อซ่อนหน้า login ชั่วคราว (ดูแดชบอร์ดตรงๆ โดยไม่ต้อง login)
NEXT_PUBLIC_SKIP_AUTH=false

# Supabase client config (จาก Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (จาก Project Settings > API > service_role)
# ใช้เฉพาะฝั่ง server เท่านั้น (app/api/ingest) ห้าม commit ค่าจริงลง git ห้ามใช้ฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=

# อีเมลผู้ดูแลระบบ (คั่นด้วย comma) — เฉพาะบัญชีเหล่านี้เท่านั้นที่ผูกอุปกรณ์ ESP ให้ผู้ใช้อื่นได้จากหน้า /admin
ADMIN_EMAILS=admin@example.com

# LINE Login Channel (จาก LINE Developers Console > สร้าง Login Channel)
# Channel ID เป็นค่า public ใช้สร้างลิงก์ login ฝั่ง client ได้ตรงๆ, Channel Secret ใช้แลก token ฝั่ง server เท่านั้น
# ต้องลงทะเบียน Callback URL ในคอนโซลให้ตรงกับ <โดเมนของเว็บ>/dashboard (และ http://localhost:3000/dashboard สำหรับ dev)
# และต้องผูก (Linked OA) เข้ากับ Messaging API Channel ด้านล่าง เพื่อให้ bot_prompt เด้งให้เพิ่มเพื่อนตอน login
NEXT_PUBLIC_LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API Channel (จาก LINE Developers Console > Messaging API ของ Official Account)
# Channel Secret ใช้ตรวจลายเซ็น webhook, Channel Access Token ใช้ส่ง push/reply message
# ต้องตั้งค่า Webhook URL ในคอนโซลเป็น <โดเมนของเว็บ>/api/line/webhook แล้วเปิด "Use webhook"
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
